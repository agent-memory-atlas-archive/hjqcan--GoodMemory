+def possessive(word: str) -> str:
+    """
+    Return the possessive form of a noun or name.
+
+    Examples::
+
+        >>> possessive("cat")
+        "cat's"
+        >>> possessive("boss")
+        "boss'"
+
+    """
+    word = word.strip()
+    if not word:
+        return word
+    if word.endswith("'") or word.endswith("'s") or word.endswith("'S"):
+        return word
+    if word[-1] in ('s', 'S'):
+        return word + "'"
+    return word + ("'S" if word[-1].isupper() else "'s")
+
