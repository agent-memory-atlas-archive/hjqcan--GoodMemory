+def count_noun(count: typing.Any, noun: str) -> str:
+    """
+    Render a count followed by the matching form of a noun.
+
+    Examples::
+
+        >>> count_noun(1, "octopi")
+        '1 octopus'
+        >>> count_noun(3, "octopus")
+        '3 octopi'
+
+    """
+    value = _integer_value(count)
+    if not noun or noun.lower() in UNCOUNTABLES:
+        word = noun
+    else:
+        word = singularize(noun)
+        if value != 1:
+            word = pluralize(word)
+    return "{:,} {}".format(value, word)
