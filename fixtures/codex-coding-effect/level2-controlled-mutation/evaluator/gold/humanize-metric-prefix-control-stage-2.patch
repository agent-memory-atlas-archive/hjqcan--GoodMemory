+def natural_percent(value: NumberOrString, precision: int = 0) -> str:
+    """Render a ratio of one as a percentage.
+
+    Examples:
+        ```pycon
+        >>> natural_percent(0.25)
+        '25%'
+        >>> natural_percent(0.3333, 1)
+        '33.3%'
+        >>> natural_percent("foo")
+        'foo'
+
+        ```
+
+    Args:
+        value (int, float, str): Ratio of one to convert.
+        precision (int): Largest number of decimals to keep.
+
+    Returns:
+        str: The percentage with a percent sign, or `str(value)` when it is not
+            a number.
+    """
+    import math
+    from decimal import ROUND_HALF_UP, Decimal, localcontext
+
+    try:
+        number = float(value)
+        if not math.isfinite(number):
+            return _format_not_finite(number)
+    except (TypeError, ValueError):
+        return str(value)
+    with localcontext() as context:
+        context.prec = 100
+        rounded = (Decimal(repr(number)) * 100).quantize(
+            Decimal(1).scaleb(-int(precision)), rounding=ROUND_HALF_UP
+        )
+        text = "{:f}".format(rounded)
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    if text.lstrip("-").replace(".", "").strip("0") == "":
+        text = "0"
+    return f"{text}%"
+
