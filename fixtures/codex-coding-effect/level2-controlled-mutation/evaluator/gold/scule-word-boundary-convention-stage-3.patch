+export function isLowercase(str = ""): boolean | undefined {
+  let cased = false;
+  for (const char of str) {
+    const lower = char.toLowerCase();
+    if (lower === char.toUpperCase()) {
+      continue;
+    }
+    cased = true;
+    if (char !== lower) {
+      return false;
+    }
+  }
+  return cased ? true : undefined;
+}
