+def _trim_amount(text: str) -> str:
+    """Drop trailing fractional zeros and never show a signed zero."""
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    if text.lstrip("-").replace(".", "").strip("0") == "":
+        return "0"
+    return text
+
+
+def _decimal_amount(number: Decimal, ndigits: int | None) -> str:
+    """Render a decimal, rounding halves away from zero to `ndigits` places."""
+    from decimal import ROUND_HALF_UP, localcontext
+
+    with localcontext() as context:
+        context.prec = 100
+        if ndigits is not None:
+            number = number.quantize(
+                Decimal(1).scaleb(-int(ndigits)), rounding=ROUND_HALF_UP
+            )
+        return _trim_amount("{:f}".format(number))
+
