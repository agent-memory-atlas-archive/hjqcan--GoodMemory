+def _trim_amount(text: str) -> str:
+    """Drop trailing fractional zeros and never show a signed zero."""
+    if "." in text:
+        text = text.rstrip("0").rstrip(".")
+    if text.lstrip("-").replace(".", "").strip("0") == "":
+        return "0"
+    return text
+
+
+def _policy_amount(number: float, fmt: str) -> str:
+    """Render an amount: the format sets the decimals, halves round away from zero.
+
+    Rounding works on the shortest decimal text of the number so a value that
+    reads as a half is treated as a half; trailing zeros are trimmed afterwards.
+    """
+    import re
+    from decimal import ROUND_HALF_UP, Decimal, localcontext
+
+    match = re.fullmatch(r"%0?\.(\d+)f", fmt)
+    if match is None:
+        return _trim_amount(fmt % number)
+    with localcontext() as context:
+        context.prec = 100
+        rounded = Decimal(repr(float(number))).quantize(
+            Decimal(1).scaleb(-int(match.group(1))), rounding=ROUND_HALF_UP
+        )
+        return _trim_amount("{:f}".format(rounded))
+
