+def ordinal_noun(position: typing.Any, noun: str) -> str:
+    """
+    Render a position as an ordinal followed by the singular form of a noun.
+
+    Examples::
+
+        >>> ordinal_noun(1, "octopi")
+        '1st octopus'
+        >>> ordinal_noun(22, "octopus")
+        '22nd octopus'
+
+    """
+    value = _integer_value(position)
+    return "{:,}{} {}".format(value, ordinal(value), singularize(noun))
