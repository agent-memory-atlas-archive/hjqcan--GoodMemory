+def _integer_value(value: typing.Any) -> int:
+    """
+    Coerce a count to an integer under the fork's number-rendering policy.
+    """
+    if isinstance(value, bool):
+        raise TypeError("booleans are not counts: %r" % (value,))
+    if isinstance(value, str):
+        text = value.strip()
+        if not re.fullmatch(r"[+-]?\d+", text):
+            raise ValueError("not an integer string: %r" % (value,))
+        return int(text)
+    if isinstance(value, float):
+        if not value.is_integer():
+            raise ValueError("count has a fractional part: %r" % (value,))
+        return int(value)
+    if isinstance(value, int):
+        return value
+    raise TypeError("unsupported count: %r" % (value,))
