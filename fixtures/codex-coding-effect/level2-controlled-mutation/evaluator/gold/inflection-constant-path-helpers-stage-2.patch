+def deconstantize(path: str) -> str:
+    """
+    Remove the rightmost segment from a constant path.
+
+    Examples::
+
+        >>> deconstantize("Widgets::Gears::Frobnicator")
+        'Widgets::Gears'
+        >>> deconstantize("Frobnicator")
+        ''
+
+    """
+    head, separator, _ = path.rpartition('::')
+    return head if separator else ''
+
