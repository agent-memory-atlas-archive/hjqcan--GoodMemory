+const STYLE_BODY_RE = /^[A-Za-z0-9]+$/;
+const STYLE_UPPER_RUN_RE = /[A-Z]{3}/;
+const STYLE_DIGIT_LOWER_RE = /[0-9][a-z]/;
+
+function matchesIdentifierStyle(str: unknown, first: RegExp): boolean {
+  if (typeof str !== "string") {
+    return false;
+  }
+  let text = str.trim();
+  if (text.startsWith("_")) {
+    text = text.slice(1);
+  }
+  if (!text || !STYLE_BODY_RE.test(text) || !first.test(text[0])) {
+    return false;
+  }
+  return !STYLE_UPPER_RUN_RE.test(text) && !STYLE_DIGIT_LOWER_RE.test(text);
+}
+
+export function isCamelCase(str = ""): boolean {
+  return matchesIdentifierStyle(str, /^[a-z]$/);
+}
