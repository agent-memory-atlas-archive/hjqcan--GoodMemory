+/**
+ * Check if two paths are equal or not. Trailing slash and encoding are normalized before comparison.
+ *
+ * @example
+ * ```js
+ * isSamePath("/foo", "/foo/"); // true
+ * ```
+ *
+ * @group utils
+ */
+interface ComparablePath {
+  leading: boolean;
+  segments: string[];
+  trailing: boolean;
+}
+
+function comparablePath(input: string, decodeSegments: boolean): ComparablePath {
+  const text = input || "";
+  const tailIndex = text.search(/[?#]/);
+  const path = tailIndex === -1 ? text : text.slice(0, tailIndex);
+  const segments = path
+    .split("/")
+    .filter((segment) => segment !== "" && segment !== ".")
+    .map((segment) => (decodeSegments ? decode(segment) : segment));
+  return {
+    leading: path.startsWith("/"),
+    segments,
+    trailing: path.length > 1 && path.endsWith("/"),
+  };
+}
+
+function sameSegments(a: readonly string[], b: readonly string[]): boolean {
+  return a.length === b.length && a.every((segment, index) => segment === b[index]);
+}
