+export function swapCase(str = ""): string {
+  let result = "";
+  for (const char of str) {
+    const upper = char.toUpperCase();
+    const lower = char.toLowerCase();
+    if (upper === lower || [...upper].length !== 1 || [...lower].length !== 1) {
+      result += char;
+      continue;
+    }
+    result += char === upper ? lower : upper;
+  }
+  return result;
+}
