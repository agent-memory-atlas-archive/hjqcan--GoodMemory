   return (str ? str[0].toUpperCase() + str.slice(1) : "") as Capitalize<S>;
 }
 
+const LEADING_UPPER_RUN_RE = /^\p{Lu}+/u;
+
 export function lowerFirst<S extends string>(str: S): Uncapitalize<S> {
-  return (str ? str[0].toLowerCase() + str.slice(1) : "") as Uncapitalize<S>;
+  if (!str) {
+    return "" as Uncapitalize<S>;
+  }
+  const run = str.match(LEADING_UPPER_RUN_RE)?.[0] ?? "";
+  if (run.length <= 1) {
+    return (str[0].toLowerCase() + str.slice(1)) as Uncapitalize<S>;
+  }
+  const next = str[run.length];
+  const keep =
+    next !== undefined && next !== next.toUpperCase()
+      ? run.length - 1
+      : run.length;
+  return (str.slice(0, keep).toLowerCase() + str.slice(keep)) as Uncapitalize<S>;
 }
 
 export function pascalCase(): "";
