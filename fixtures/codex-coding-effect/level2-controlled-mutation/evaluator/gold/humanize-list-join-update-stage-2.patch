+def intabbr(value: NumberOrString) -> str:
+    """Converts a large integer to a compact abbreviation such as 1.5K or 2M.
+
+    Examples:
+        ```pycon
+        >>> intabbr(1500)
+        '1.5K'
+        >>> intabbr(2000000)
+        '2M'
+        >>> intabbr("foo")
+        'foo'
+
+        ```
+
+    Args:
+        value (int, float, str): Integer to convert.
+
+    Returns:
+        str: Compact representation, unless the value could not be coaxed into an
+            `int`, in which case `str(value)` is returned.
+    """
+    import math
+
+    try:
+        if not math.isfinite(float(value)):
+            return _format_not_finite(float(value))
+        value = int(value)
+    except (TypeError, ValueError):
+        return str(value)
+
+    sign = "-" if value < 0 else ""
+    magnitude = abs(value)
+    if magnitude < 1000:
+        return f"{sign}{magnitude}"
+
+    letters = "KMBT"
+    index = 0
+    amount = magnitude / 1000
+    while amount >= 1000 and index < len(letters) - 1:
+        amount /= 1000
+        index += 1
+    text = f"{amount:.1f}"
+    if float(text) >= 1000 and index < len(letters) - 1:
+        amount /= 1000
+        index += 1
+        text = f"{amount:.1f}"
+    if text.endswith(".0"):
+        text = text[:-2]
+    return f"{sign}{text}{letters[index]}"
+
+
