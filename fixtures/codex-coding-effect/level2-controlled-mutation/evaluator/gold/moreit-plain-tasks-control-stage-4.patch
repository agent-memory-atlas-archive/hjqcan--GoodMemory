+def run_lengths(iterable):
+    """Yield ``(item, count)`` pairs for each run of equal consecutive items
+    in *iterable*.
+
+    >>> list(run_lengths('aabbbc'))
+    [('a', 2), ('b', 3), ('c', 1)]
+
+    """
+    for item, group in groupby(iterable):
+        yield item, ilen(group)
