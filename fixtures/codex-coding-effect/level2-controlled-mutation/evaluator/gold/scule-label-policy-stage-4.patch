+const LABEL_SEPARATOR_RE = /[-_/.\s]+/u;
+const LABEL_NOISE_RE = /[^\p{L}\p{N}']/gu;
+const LABEL_UPPER_RE = /^\p{Lu}+$/u;
+const LABEL_PLURAL_TAIL_RE = /^\p{Lu}s$/u;
+
+function splitLabelWords(str: string | readonly string[]): string[] {
+  const chunks = Array.isArray(str)
+    ? [...str]
+    : typeof str === "string"
+      ? str.split(LABEL_SEPARATOR_RE)
+      : [];
+  const words: string[] = [];
+  for (const chunk of chunks) {
+    const cleaned = chunk.replace(LABEL_NOISE_RE, "");
+    if (!cleaned) {
+      continue;
+    }
+    const merged: string[] = [];
+    for (const part of splitByCase(cleaned, [])) {
+      if (!part) {
+        continue;
+      }
+      const previous = merged.at(-1);
+      if (
+        previous !== undefined &&
+        LABEL_UPPER_RE.test(previous) &&
+        LABEL_PLURAL_TAIL_RE.test(part)
+      ) {
+        merged[merged.length - 1] = previous + part;
+      } else {
+        merged.push(part);
+      }
+    }
+    words.push(...merged);
+  }
+  return words;
+}
+
 const titleCaseExceptions =
   /^(a|an|and|as|at|but|by|for|if|in|is|nor|of|on|or|the|to|with)$/i;
 
