+def clocktime(value: dt.timedelta | float | str) -> str:
+    """Render a number of seconds as a clock-style H:MM:SS string.
+
+    ```pycon
+    >>> clocktime(3725)
+    '1:02:05'
+    >>> clocktime(45)
+    '0:00:45'
+
+    ```
+
+    Args:
+        value (datetime.timedelta, int, float or str): A timedelta or a number of
+            seconds.
+
+    Returns:
+        str: Hours, minutes and seconds separated by colons, or `str(value)` when
+            it is not a finite number.
+    """
+    import datetime as dt
+    import math
+
+    if isinstance(value, dt.timedelta):
+        seconds = value.total_seconds()
+    else:
+        try:
+            seconds = float(value)
+        except (TypeError, ValueError):
+            return str(value)
+        if not math.isfinite(seconds):
+            return str(value)
+    sign = "-" if seconds < 0 else ""
+    whole = int(abs(seconds))
+    hours, remainder = divmod(whole, 3600)
+    minutes, secs = divmod(remainder, 60)
+    return f"{sign}{hours}:{minutes:02d}:{secs:02d}"
+
