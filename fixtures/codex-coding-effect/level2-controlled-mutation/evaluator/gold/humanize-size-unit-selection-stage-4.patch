+def naturalbitrate(
+    value: float | str,
+    binary: bool = False,
+    format: str = "%.1f",
+) -> str:
+    """Format a number of bits per second like a human-readable rate.
+
+    Examples:
+        ```pycon
+        >>> naturalbitrate(3000000)
+        '3.0 Mbit/s'
+        >>> naturalbitrate(3000, True)
+        '2.9 Kibit/s'
+        >>> naturalbitrate(300)
+        '300 bit/s'
+
+        ```
+
+    Args:
+        value (int, float, str): Bits per second to convert.
+        binary (bool): If `True`, uses binary prefixes (Kibit/s, Mibit/s) with base
+            2<sup>10</sup> instead of 10<sup>3</sup>.
+        format (str): Custom formatter for the amount.
+
+    Returns:
+        str: Human readable representation of a bit rate.
+    """
+    suffix = bitrate_suffixes["binary" if binary else "decimal"]
+    base = 1024 if binary else 1000
+    bits = float(value)
+    if not isfinite(bits):
+        return _format_not_finite(bits)
+    abs_bits = abs(bits)
+
+    if abs_bits < base:
+        return f"{int(bits)} bit/s"
+
+    amount, index = _select_unit(abs_bits, base, len(suffix), format)
+    sign = "-" if bits < 0 else ""
+    return f"{sign}{amount}{suffix[index]}"
