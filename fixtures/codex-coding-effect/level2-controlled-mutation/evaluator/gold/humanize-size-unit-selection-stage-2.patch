+def apordinal(value: NumberOrString) -> str:
+    """Converts a small integer to a spelled-out ordinal, Associated Press style.
+
+    Examples:
+      ```pycon
+      >>> apordinal(1)
+      'first'
+      >>> apordinal(21)
+      '21st'
+      >>> apordinal("foo")
+      'foo'
+
+      ```
+
+    Args:
+        value (int, float, str): Integer to convert.
+
+    Returns:
+        str: The spelled ordinal word for small positive integers; otherwise the
+            digit form with its suffix, or `str(value)` when it is not a whole
+            non-negative number.
+    """
+    import math
+
+    try:
+        number = float(value)
+        if not math.isfinite(number):
+            return _format_not_finite(number)
+    except (TypeError, ValueError):
+        return str(value)
+    if number < 0 or number != int(number):
+        return str(value)
+    number = int(number)
+    if not 1 <= number <= 9:
+        return ordinal(number)
+    return (
+        _("first"),
+        _("second"),
+        _("third"),
+        _("fourth"),
+        _("fifth"),
+        _("sixth"),
+        _("seventh"),
+        _("eighth"),
+        _("ninth"),
+    )[number - 1]
