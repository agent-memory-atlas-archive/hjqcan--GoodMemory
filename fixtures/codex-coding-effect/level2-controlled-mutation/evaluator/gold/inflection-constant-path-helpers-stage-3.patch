+def foreign_key(word: str,
+                separate_class_name_and_id_with_underscore: bool = True) -> str:
+    """
+    Create a foreign key name from a class name.
+
+    Examples::
+
+        >>> foreign_key("Widgets::Frobnicator")
+        'frobnicator_id'
+        >>> foreign_key("Frobnicator", False)
+        'frobnicatorid'
+
+    """
+    name = underscore(word.rsplit('::', 1)[-1])
+    if separate_class_name_and_id_with_underscore:
+        return name + '_id'
+    return name + 'id'
+
