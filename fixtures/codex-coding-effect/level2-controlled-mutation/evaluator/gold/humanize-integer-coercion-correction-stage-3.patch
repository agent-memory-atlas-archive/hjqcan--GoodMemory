+def engineering(value: NumberOrString, precision: int = 2) -> str:
+    """Return number in engineering notation, with an exponent that is a multiple of three.
+
+    Examples:
+        ```pycon
+        >>> engineering(15000)
+        '15.00 x 10³'
+        >>> engineering(1500, 1)
+        '1.5 x 10³'
+        >>> engineering("foo")
+        'foo'
+
+        ```
+
+    Args:
+        value (int, float, str): Input number.
+        precision (int): Number of decimals for the mantissa.
+
+    Returns:
+        str: Number as a mantissa below one thousand times a power of ten whose
+            exponent is a multiple of three.
+    """
+    import math
+
+    try:
+        value = float(value)
+        if not math.isfinite(value):
+            return _format_not_finite(value)
+    except (ValueError, TypeError):
+        return str(value)
+    exponent = 0
+    if value != 0:
+        exponent = int(math.floor(math.log10(abs(value)))) // 3 * 3
+    mantissa = _scale_by_power_of_ten(value, -exponent)
+    text = f"{mantissa:.{int(precision)}f}"
+    if abs(float(text)) >= 1000:
+        exponent += 3
+        mantissa /= 1000
+        text = f"{mantissa:.{int(precision)}f}"
+    superscript = "".join(_SUPERSCRIPTS[char] for char in str(exponent))
+    return f"{text} x 10{superscript}"
+
+
+def _scale_by_power_of_ten(value: float, power: int) -> float:
+    """Multiply `value` by ten to the given power without dividing by tiny floats."""
+    if power >= 0:
+        return value * 10.0**power
+    return value / 10.0 ** (-power)
+
