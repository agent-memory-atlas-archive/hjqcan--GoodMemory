+_PHRASE_PREPOSITIONS: typing.FrozenSet[str] = frozenset(
+    ['of', 'in', 'at', 'on', 'for', 'to'])
+
+
+def _inflect_phrase(phrase: str, inflect: typing.Callable[[str], str]) -> str:
+    """
+    Inflect the head part of a phrase with ``inflect`` and rejoin the parts.
+    """
+    parts = re.split(r"(\s+|-)", phrase.strip())
+    if not parts[0]:
+        return ''
+    words = parts[0::2]
+    joiners = ['-' if joiner == '-' else ' ' for joiner in parts[1::2]]
+    head = len(words) - 1
+    for index in range(1, len(words)):
+        if words[index].lower() in _PHRASE_PREPOSITIONS:
+            head = index - 1
+            break
+    words[head] = inflect(words[head])
+    result = words[0]
+    for joiner, word in zip(joiners, words[1:]):
+        result += joiner + word
+    return result
+
