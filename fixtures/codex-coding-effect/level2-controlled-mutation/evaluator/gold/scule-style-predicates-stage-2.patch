+const PATH_SEPARATOR_RE = /[-_/.\s]+/u;
+
+export function pathCase(str: string | readonly string[] = ""): string {
+  const chunks = Array.isArray(str)
+    ? [...str]
+    : typeof str === "string"
+      ? str.split(PATH_SEPARATOR_RE)
+      : [];
+  const words = chunks
+    .flatMap((chunk) => splitByCase(chunk, []))
+    .filter(Boolean)
+    .map((word) => word.toLowerCase());
+  if (words.length === 0) {
+    return "";
+  }
+  const leading = typeof str === "string" && str.startsWith("/") ? "/" : "";
+  return leading + words.join("/");
+}
