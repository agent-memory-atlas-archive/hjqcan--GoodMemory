+
+def _prepare_items(items: Any) -> list[str]:
+    """Render items as stripped text, dropping empties and repeated items."""
+    prepared: list[str] = []
+    for item in items:
+        text = str(item).strip()
+        if not text or text in prepared:
+            continue
+        prepared.append(text)
+    return prepared
+
+
+def _join_items(texts: list[str], conjunction: str) -> str:
+    """Join prepared items with semicolons and the conjunction before the last one."""
+    if not texts:
+        return ""
+    if len(texts) == 1:
+        return texts[0]
+    if len(texts) == 2:
+        return f"{texts[0]} {conjunction} {texts[1]}"
+    return "; ".join(texts[:-1]) + f" {conjunction} {texts[-1]}"
+
+
+def natural_or_list(items: list[Any]) -> str:
+    """Natural list of alternatives.
+
+    Convert a list of items into a human-readable string joined with 'or'.
+
+    Examples:
+        >>> natural_or_list(["one", "two", "three"])
+        'one; two or three'
+        >>> natural_or_list(["one", "two"])
+        'one or two'
+        >>> natural_or_list(["one"])
+        'one'
+
+    Args:
+        items (list): An iterable of items.
+
+    Returns:
+        str: A string with separators and 'or' in the right places.
+    """
+    return _join_items(_prepare_items(items), "or")
