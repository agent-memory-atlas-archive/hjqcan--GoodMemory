   }
-  const keys = Object.keys(obj) as TKey[]
-  return keys.reduce(
-    (acc, key) => {
-      acc[obj[key]] = key
-      return acc
-    },
-    {} as Record<TValue, TKey>,
-  )
+  const assign = (value: unknown, key: TKey) => {
+    if (value == null) {
+      return
+    }
+    const newKey = value as TValue
+    if (!Object.prototype.hasOwnProperty.call(result, newKey)) {
+      result[newKey] = key
+    }
+  }
+  for (const key of Object.keys(obj) as TKey[]) {
+    const value: unknown = obj[key]
+    if (Array.isArray(value)) {
+      for (const element of value) {
+        assign(element, key)
+      }
+    } else {
+      assign(value, key)
+    }
+  }
+  return result
 }
