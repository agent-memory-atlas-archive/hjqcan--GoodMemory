+def _mirror_case(original: str, inflected: str) -> str:
+    """
+    Restore the letter case of ``original`` onto ``inflected``, which was
+    computed from the lowercased original.
+    """
+    letters = [char for char in original if char.isalpha()]
+    if not letters:
+        return inflected
+    lowered = original.lower()
+    prefix = 0
+    while (prefix < len(lowered) and prefix < len(inflected)
+           and lowered[prefix] == inflected[prefix]):
+        prefix += 1
+    tail_upper = letters[-1].isupper()
+    result = []
+    for index, char in enumerate(inflected):
+        if index < prefix:
+            result.append(original[index])
+        elif index == 0:
+            result.append(char.upper() if letters[0].isupper() else char.lower())
+        else:
+            result.append(char.upper() if tail_upper else char.lower())
+    return ''.join(result)
+
