+def is_monotonic(iterable):
+    """Returns ``True`` if the items of *iterable* are entirely non-decreasing
+    or entirely non-increasing, and ``False`` otherwise.
+
+    >>> is_monotonic([1, 2, 2, 3])
+    True
+    >>> is_monotonic([3, 2, 2, 1])
+    True
+    >>> is_monotonic([1, 3, 2])
+    False
+
+    Empty and single-item iterables are monotonic.
+    """
+    items = list(iterable)
+    return is_sorted(items) or is_sorted(items, reverse=True)
