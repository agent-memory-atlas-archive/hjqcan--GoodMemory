+def _select_unit(
+    magnitude: float, base: int, suffix_count: int, format: str
+) -> tuple[str, int]:
+    """Pick a suffix index and formatted amount for a magnitude of at least one base.
+
+    The suffix is found by stepping through the table with plain comparisons.
+    After formatting, an amount that reads as a whole base or more is carried
+    into the next suffix (and formatted again) while a larger suffix exists.
+    """
+    amount = magnitude / base
+    index = 0
+    while amount >= base and index < suffix_count - 1:
+        amount /= base
+        index += 1
+    text = format % amount
+    while index < suffix_count - 1 and _reads_at_least(text, base):
+        amount /= base
+        index += 1
+        text = format % amount
+    return text, index
+
+
+def _reads_at_least(text: str, threshold: float) -> bool:
+    """Whether a formatted amount reads as at least the given threshold."""
+    try:
+        return float(text) >= threshold
+    except ValueError:
+        return False
+
+
