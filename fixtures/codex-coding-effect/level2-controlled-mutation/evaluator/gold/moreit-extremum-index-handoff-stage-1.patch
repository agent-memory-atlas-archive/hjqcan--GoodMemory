+def _extremum_index(iterable, better):
+    best_index = None
+    best_value = None
+    for index, value in enumerate(iterable):
+        if value is None:
+            continue
+        candidate = value.casefold() if isinstance(value, str) else value
+        if best_index is None or not better(best_value, candidate):
+            best_index, best_value = index, candidate
+    if best_index is None:
+        raise ValueError('no comparable items in the input')
+    return best_index
+
