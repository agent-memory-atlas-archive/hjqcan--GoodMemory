+def classify(table_name: str) -> str:
+    """
+    Create a class name from a plural table name like Rails does for table
+    names to models.
+
+    Examples::
+
+        >>> classify("frobnicators")
+        'Frobnicator'
+        >>> classify("shop.gear_boxes")
+        'GearBox'
+
+    """
+    return camelize(singularize(table_name.rsplit('.', 1)[-1]))
