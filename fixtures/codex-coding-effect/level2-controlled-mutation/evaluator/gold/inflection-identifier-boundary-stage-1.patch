+def _identifier_words(word: str) -> typing.List[str]:
+    """
+    Split an identifier into lowercase words following the fork's
+    identifier-boundary convention.
+    """
+    word = word.replace("'", "")
+    word = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", word)
+    word = re.sub(r"([a-z])([A-Z])", r"\1 \2", word)
+    word = re.sub(r"(\d+)", r" \1 ", word)
+    return [part.lower() for part in re.split(r"[^A-Za-z0-9]+", word) if part]
+
