+def kebabize(word: str) -> str:
+    """
+    Make a hyphen-separated, lowercase form from the expression in the string.
+
+    Example::
+
+        >>> kebabize("DeviceType")
+        'device-type'
+
+    """
+    return "-".join(_identifier_words(word))
