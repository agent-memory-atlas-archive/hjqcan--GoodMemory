+def nth_index(iterable, value, n):
+    """Return the index of the *n*-th occurrence of *value* in *iterable*,
+    counting occurrences from one.
+
+    >>> nth_index('AABCADEAF', 'A', 3)
+    4
+
+    ``ValueError`` is raised when *n* is below one or when *value* occurs
+    fewer than *n* times.
+    """
+    if n < 1:
+        raise ValueError('n must be at least one')
+    seen = 0
+    for index, element in enumerate(iterable):
+        if element is value or element == value:
+            seen += 1
+            if seen == n:
+                return index
+    raise ValueError('value does not occur enough times')
+
