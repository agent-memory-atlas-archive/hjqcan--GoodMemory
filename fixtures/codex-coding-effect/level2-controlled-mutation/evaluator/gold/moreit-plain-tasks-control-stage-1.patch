+def longest_common_suffix(iterables):
+    """Yield elements of the longest common suffix among given *iterables*.
+
+    >>> ''.join(longest_common_suffix(['xbcd', 'abcd', 'bcd']))
+    'bcd'
+
+    """
+    sequences = [list(iterable) for iterable in iterables]
+    if not sequences:
+        return
+    first = sequences[0]
+    shortest = min(len(sequence) for sequence in sequences)
+    length = 0
+    while length < shortest and all(
+        sequence[-1 - length] == first[-1 - length] for sequence in sequences[1:]
+    ):
+        length += 1
+    yield from first[len(first) - length :]
+
